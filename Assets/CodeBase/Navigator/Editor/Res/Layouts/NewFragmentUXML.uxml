<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/CodeBase/Navigator/Editor/Res/Styles/Modal.uss?fileID=7433441132597879392&amp;guid=cef7e4787482d7d4f9987cef2b984c57&amp;type=3#Modal" />
    <ui:VisualElement class="body">
        <ui:VisualElement style="flex-shrink: 0;">
            <ui:EnumField label="Layout" type="Navigator.Data.StaticData.LayoutType, Runtime" name="type--fragment" class="field" />
            <ui:TextField picking-mode="Ignore" label="Name" value="type id of new fragment" name="name--fragment" class="field" />
            <ui:TextField picking-mode="Ignore" label="Fragment ID" value="type id of new fragment" name="id--fragment" class="field" />
            <ui:TextField picking-mode="Ignore" label="Class Name" value="type id of new fragment" readonly="true" focusable="false" name="class-name--fragment" class="field" />
        </ui:VisualElement>
        <ui:VisualElement class="container-controller">
            <ui:Button text="Create" parse-escape-sequences="true" display-tooltip-when-elided="true" name="create-btn" />
            <ui:Button text="Cancel" parse-escape-sequences="true" display-tooltip-when-elided="true" name="cancel-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
